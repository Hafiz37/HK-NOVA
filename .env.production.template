# HK-NOVA Production Environment Configuration
# SECURITY TEMPLATE - DO NOT PUT REAL CREDENTIALS HERE
# Generated: 2026-09-05
# IMPORTANT: Copy this to .env.production and replace ALL placeholder values!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Replace with your actual production database credentials
# Connection Pool Configuration:
#   - connection_limit: Max connections from this app instance (default: 10)
#   - pool_timeout: Seconds to wait for available connection (default: 10)
#   - connect_timeout: Seconds to wait for initial connection (default: 5)
# Example: mysql://user:pass@host:3306/db?connection_limit=20&pool_timeout=10&connect_timeout=5
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME?connection_limit=10&pool_timeout=10&connect_timeout=5"

# Database Pool Configuration (Optional - overrides URL params)
DB_POOL_MIN="2"
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_ACQUIRE_TIMEOUT_MS="10000"

# ============================================================================
# SECURITY - ENCRYPTION KEYS (Generate with: openssl rand -hex 32)
# ============================================================================
# CRITICAL: Generate unique keys for production!
# Run: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL"

# Run: openssl rand -hex 32
AUDIT_HMAC_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL"

# Run: openssl rand -hex 64
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_64_BYTES"

# Run: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# CRITICAL: Change these credentials before deployment!
# Username: min 4 chars, alphanumeric + underscore/dash
# Password: min 16 chars, must include: uppercase, lowercase, numbers, special chars
OPERATOR_USERNAME="CHANGE_ME"
OPERATOR_PASSWORD="CHANGE_ME_MIN_16_CHARS"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_MODE="production"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis connection URL
# Format: redis://[username:password@]host:port[/db-number]
# For cluster: redis://host1:port1,host2:port2
REDIS_URL="redis://localhost:6379"
REDIS_QUEUE_TTL_SECONDS="600"

# Redis Connection Pool Settings
REDIS_MAX_RETRIES_PER_REQUEST="3"
REDIS_CONNECT_TIMEOUT="5000"
REDIS_COMMAND_TIMEOUT="5000"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Disable demo mode in production
DEMO_MODE_ENABLED="false"

# Keep OLT execution disabled until thoroughly tested
ENABLE_OLT_EXECUTION="false"

# Enable ML Anomaly Detection
ENABLE_ML_ANOMALY="true"

# ============================================================================
# NOTIFICATION CHANNELS (Optional - configure as needed)
# ============================================================================
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noc@yourdomain.com"
SMTP_RECIPIENTS=""

# Webhook Notifications (Slack/Discord)
NOTIFY_WEBHOOK_URLS=""

# SIEM Integration (Splunk/ELK)
SIEM_WEBHOOK_URLS=""
SIEM_WEBHOOK_TOKEN=""
SIEM_FORMAT="generic"

# SMS Gateway Configuration
SMS_API_URL=""
SMS_API_KEY=""
SMS_ACCOUNT_SID=""
SMS_SENDER_ID=""
SMS_TO_NUMBERS=""

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_LOGIN_LIMIT="5"
RATE_LIMIT_TEST_LIMIT="10"
RATE_LIMIT_MUTATION_LIMIT="30"
RATE_LIMIT_USERS_LIMIT="15"
RATE_LIMIT_SETTINGS_LIMIT="15"
RATE_LIMIT_EXPORT_LIMIT="5"
RATE_LIMIT_READ_LIMIT="60"
RATE_LIMIT_READ_LOOPBACK_LIMIT="2000"
RATE_LIMIT_PROVISION_LIMIT="10"
RATE_LIMIT_PROVISION_LOOPBACK_LIMIT="2000"

# ============================================================================
# WORKER SCHEDULES (Cron Format)
# ============================================================================
# ICMP Polling - Every 1 minute
ICMP_POLL_INTERVAL="*/1 * * * *"
ICMP_BATCH_SIZE="20"
ICMP_CONCURRENCY_LIMIT="10"

# SNMP Polling - Every 5 minutes
SNMP_POLL_INTERVAL="*/5 * * * *"
SNMP_BATCH_SIZE="20"
SNMP_CONCURRENCY_LIMIT="10"

# Anomaly Detection - Every 10 minutes
ANOMALY_CHECK_INTERVAL="*/10 * * * *"

# Alert Escalation - Every minute
ESCALATOR_INTERVAL="* * * * *"

# Digest Worker - Every minute
DIGEST_INTERVAL="* * * * *"

# Delivery Retry - Every 2 minutes
RETRY_INTERVAL="*/2 * * * *"

# Data Retention - Daily at 3 AM
RETENTION_BATCH_SIZE="1000"
RETENTION_CRON_SCHEDULE="0 3 * * *"
RETENTION_DRY_RUN="false"

# Scheduled Provisioning - Every minute
SCHEDULED_PROVISIONING_CRON="* * * * *"

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
# Backup Schedule - Daily at 2 AM
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_RUN_ON_STARTUP="true"
BACKUP_CONCURRENCY="4"

# Backup Retention
BACKUP_RETENTION_DAYS="365"
BACKUP_SOFT_DELETE_GRACE_DAYS="30"
BACKUP_CLEANUP_SCHEDULE="0 4 * * *"

# Backup Storage
BACKUP_STORAGE_TIERED="false"
BACKUP_HOT_DAYS="30"
BACKUP_FILESYSTEM_PATH="/var/backups/hk-nova"
BACKUP_ARCHIVE_SCHEDULE="0 3 * * *"
BACKUP_ARCHIVE_BATCH_SIZE="100"

# Backup Smart Scheduling & Bandwidth Control
BACKUP_MAX_PER_SUBNET="2"
BACKUP_SKIP_HIGH_LATENCY="true"
BACKUP_LATENCY_THRESHOLD_MS="500"
BACKUP_ALLOWED_HOURS="02:00-05:00"

# Backup Notifications
BACKUP_NOTIFICATIONS_ENABLED="true"
BACKUP_DAILY_DIGEST_ENABLED="true"
BACKUP_DAILY_DIGEST_TIME="08:00"
BACKUP_CRITICAL_ALERTS_ENABLED="true"
BACKUP_STORAGE_ALERTS_ENABLED="true"
BACKUP_STORAGE_ALERT_THRESHOLD="80"
BACKUP_FAILED_ALERTS_ENABLED="true"
BACKUP_FAILED_ALERT_THRESHOLD="3"
BACKUP_WEBHOOK_URL=""
BACKUP_EMAIL_RECIPIENTS=""

# ============================================================================
# ML ANOMALY DETECTION CONFIGURATION
# ============================================================================
ANOMALY_TRAINING_DAYS="7"
ANOMALY_MIN_SAMPLES="50"
ANOMALY_SCORE_THRESHOLD_HIGH="0.7"
ANOMALY_SCORE_THRESHOLD_CRITICAL="0.85"

