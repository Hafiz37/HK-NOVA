.env
.env.local
.env.home
.env.office
.env.backup*
.env.production
.env.production.local
.env.production.backup*
.env.production.OLD_INSECURE
.env.*.local
production-secrets*.txt
production-secrets*.gpg
*.key
*.p12
*.pfx
