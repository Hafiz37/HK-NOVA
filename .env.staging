# HK-NOVA Staging Environment Configuration
# This file should be copied to production server and filled with real values

NODE_ENV=staging
PORT=3000

# Database
DATABASE_URL="mysql://hk_nova_user:hk_nova_pass_change_me@mysql:3306/hk_nova_staging"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Security Keys (Generate new ones for staging!)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="GENERATE_NEW_KEY_FOR_STAGING"
AUDIT_HMAC_KEY="GENERATE_NEW_KEY_FOR_STAGING"
JWT_SECRET="GENERATE_NEW_KEY_FOR_STAGING"
BACKUP_ENCRYPTION_KEY="GENERATE_NEW_KEY_FOR_STAGING"

# Authentication
OPERATOR_USERNAME="admin"
OPERATOR_PASSWORD="CHANGE_ME_STAGING_PASSWORD"

# Application
APP_MODE=staging
APP_URL=http://staging.hk-nova.local:3000

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_ENABLED=true

# Workers Configuration
ICMP_BATCH_SIZE=20
ICMP_CONCURRENCY_LIMIT=10
SNMP_BATCH_SIZE=20
SNMP_CONCURRENCY_LIMIT=10

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/app/backups

# Alert Configuration
ALERT_ENGINE_ENABLED=true
ALERT_BATCH_SIZE=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
