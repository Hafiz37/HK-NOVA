// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  ROUTER
  SWITCH
  OLT
  ONT
  FIREWALL
  SERVER
  OTHER
}

enum DeviceStatus {
  UP
  DOWN
  UNKNOWN
  MAINTENANCE
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  ACKNOWLEDGED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  DEVICE_DOWN
  DEVICE_UP
  HIGH_UTILIZATION
  ANOMALY_DETECTED
  BACKUP_FAILED
  PROVISIONING_FAILED
  CUSTOM_OID_OUT_OF_RANGE
  RULE_BREACH
  HIGH_CPU
  HIGH_MEMORY
  INTERFACE_DOWN
  INTERFACE_ERRORS
}

enum AlertActivityAction {
  CREATED
  ACKNOWLEDGED
  RESOLVED
  ASSIGNED
  NOTE_ADDED
  ESCALATED
  REOPENED
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AlertRuleOperator {
  GT
  GTE
  LT
  LTE
}

enum AlertRuleDeviceScope {
  ALL
  DEVICE_TYPE
  DEVICES
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProvisioningAction {
  CREATE
  SUSPEND
  REACTIVATE
  TERMINATE
  STATUS_CHECK
}

enum ProvisioningStatus {
  SUCCESS
  FAILED
  PENDING
  DRY_RUN
}

enum ExecutionMode {
  EXECUTE
  DRY_RUN
  SCHEDULED
}

enum BatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum ScheduledProvisioningStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BackupStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum MetricSource {
  REAL
  DEMO
  GENERATOR
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  scope       String?  // "GLOBAL" | "DEVICE:<deviceId>" | "USER:<userId>"
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([key])
  @@index([scope])
}

model ExportTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  format      String   // "csv" | "xlsx" | "pdf"
  filters     Json
  columns     Json
  isDefault   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, createdBy])
  @@index([createdBy])
  @@index([isDefault])
}

model BatchProvisioning {
  id            String      @id @default(cuid())
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action        ProvisioningAction
  templateName  String?
  items         Json        // Array of ProvisioningFields
  status        BatchStatus @default(PENDING)
  totalItems    Int
  successCount  Int         @default(0)
  failedCount   Int         @default(0)
  continueOnError Boolean  @default(true)
  parallelExecution Boolean @default(false)
  createdBy     String
  createdAt     DateTime    @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  metadata      Json?

  @@index([deviceId, createdAt])
  @@index([status])
  @@index([createdBy])
}

model ScheduledProvisioning {
  id          String                    @id @default(cuid())
  deviceId    String
  device      Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action      ProvisioningAction
  templateName String?
  fields      Json                      // ProvisioningFields
  scheduledAt DateTime
  status      ScheduledProvisioningStatus @default(PENDING)
  executedAt  DateTime?
  logId       String?                   @unique
  log         ProvisioningLog?          @relation(fields: [logId], references: [id], onDelete: SetNull)
  createdBy   String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([scheduledAt, status])
  @@index([deviceId])
  @@index([createdBy])
}

model OltTemplateVersion {
  id          String   @id @default(cuid())
  name        String   // "huawei", "zte", "generic"
  version     String   // "1.0.0"
  content     Json     // Template JSON
  isActive    Boolean  @default(false)
  changelog   String?  @db.Text
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, version])
  @@index([name, isActive])
}

model ProvisioningRequest {
  id           String            @id @default(cuid())
  deviceId     String
  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action       ProvisioningAction
  templateName String?
  fields       Json              // ProvisioningFields
  status       RequestStatus     @default(PENDING)
  requestedBy  String
  requestedAt  DateTime          @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectionReason String?        @db.Text
  logId        String?           @unique
  log          ProvisioningLog?  @relation(fields: [logId], references: [id], onDelete: SetNull)
  metadata     Json?

  @@index([status, requestedAt])
  @@index([deviceId])
  @@index([requestedBy])
}

model AlertCooldown {
  id          String   @id @default(cuid())
  deviceId    String
  channel     String // "telegram" | "email" | "webhook" | "sms"
  cooldownKey String   @default("default") // "default" | "cpu" | "mem" | "cpu-recover" | "mem-recover"
  cooldownAt  DateTime @db.Timestamp(3)
  createdAt   DateTime @default(now())

  @@unique([deviceId, channel, cooldownKey])
  @@index([deviceId])
  @@index([cooldownAt])
}

model Device {
  id          String       @id @default(cuid())
  name        String
  ip          String       @unique
  type        DeviceType
  vendor      String?
  model       String?
  location    String?
  status      DeviceStatus @default(UNKNOWN)
  description String?      @db.Text
  isDemo      Boolean      @default(false)

  // Per-device threshold overrides (null = pakai nilai global dari constants.ts)
  cpuThresholdOverride        Float?
  memThresholdOverride        Float?
  cpuResolveThresholdOverride Float?
  memResolveThresholdOverride Float?

  // Backup configuration
  backupSchedule      String? // cron format, null = use global
  backupEnabled       Boolean @default(true)
  backupPriority      Int     @default(50) // 0-100, higher = backup first
  backupRetentionDays Int? // null = use global setting

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  credentials       Credential?
  metrics           Metric[]
  backups           Backup[]
  backupRestores    BackupRestore[]
  provisioning           ProvisioningLog[]
  batchProvisioning      BatchProvisioning[]
  scheduledProvisioning  ScheduledProvisioning[]
  provisioningRequests   ProvisioningRequest[]
  anomalies              Anomaly[]
  alerts                 Alert[]
  MaintenanceWindow      MaintenanceWindow[]
  customOids             CustomOid[]
  thresholds             DeviceThreshold[]
  anomalyRiskPredictions AnomalyRiskPrediction[]

  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@index([isDemo])
}

model Credential {
  id       String @id @default(cuid())
  deviceId String @unique
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  snmpVersion   String?
  snmpCommunity String? @db.Text
  snmpUser      String?
  snmpAuthPass  String? @db.Text
  snmpPrivPass  String? @db.Text
  snmpPort      Int?    @default(161)

  sshUsername String?
  sshPassword String? @db.Text
  sshPort     Int?    @default(22)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Metric {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp  DateTime     @default(now())
  metricType String
  source     MetricSource @default(REAL)

  // ICMP metrics
  latency    Float?
  packetLoss Float?
  // ICMPv6 / Jitter / RTT detail
  jitter     Float? // variasi RTT antar probe (ms)
  rttMin     Float? // RTT minimum probe (ms)
  rttMax     Float? // RTT maximum probe (ms)
  isIPv6     Boolean @default(false)

  // SNMP metrics
  cpuUtil Float?
  memUtil Float?

  interfaceData Json?
  // Custom OID results — key: oid string, value: parsed number/string
  customOidData Json?

  @@index([deviceId, timestamp])
  @@index([metricType, timestamp])
  @@index([deviceId, metricType, timestamp]) // Composite for time-series queries per device & type
  @@index([source])
  @@index([timestamp]) // For time-range scans
}

model Backup {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp       DateTime     @default(now())
  configHash      String
  configContent   Bytes?       @db.MediumBlob
  isCompressed    Boolean      @default(false)
  isEncrypted     Boolean      @default(false)
  sizeBytes       Int?
  compressedBytes Int?
  changeDetected  Boolean      @default(true)
  status          BackupStatus
  errorMessage    String?      @db.Text

  isProtected     Boolean         @default(false)
  deletedAt       DateTime?
  storageLocation String          @default("database")
  filePath        String?
  archivedAt      DateTime?
  changesSummary  Json?
  criticalChanges Json?
  riskScore       Float?
  durationMs      Int?
  sshConnectMs    Int?
  BackupRestore   BackupRestore[]

  @@index([deviceId, timestamp])
  @@index([storageLocation])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([isProtected])
  @@index([riskScore])
}

model BackupRestore {
  id       String @id @default(cuid())
  backupId String
  backup   Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  restoredBy String
  user       User     @relation(fields: [restoredBy], references: [id])
  restoredAt DateTime @default(now())

  status ProvisioningStatus
  dryRun Boolean            @default(false)

  preRestoreBackupId String?

  command      String  @db.Text
  response     String? @db.Text
  errorMessage String? @db.Text
  durationMs   Int?

  @@index([deviceId, restoredAt])
  @@index([backupId])
  @@index([restoredBy])
  @@index([status])
}

model BackupMetrics {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  totalDevices  Int
  successCount  Int
  failedCount   Int
  skippedCount  Int
  avgDurationMs Int
  maxDurationMs Int
  minDurationMs Int

  dbStorageMB         Float
  filesystemStorageMB Float?
  totalBackupCount    Int
  compressionRatio    Float?

  criticalChangesCount Int   @default(0)
  consecutiveFailures  Json?

  @@index([timestamp])
}

model ProvisioningLog {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  action            ProvisioningAction
  ontSerial         String?
  ponPort           String?
  vlan              Int?
  serviceProfile    String?

  command           String             @db.Text
  response          String?            @db.Text
  status            ProvisioningStatus
  errorMessage      String?            @db.Text

  // Sprint 1: Enhanced logging
  templateName      String?
  templateVersion   String?
  executionMode     ExecutionMode      @default(EXECUTE)
  executionTimeMs   Int?
  clientIp          String?
  userAgent         String?
  metadata          Json?

  // Sprint 2: Rollback support
  isRollback        Boolean               @default(false)
  rollbackLogId     String?
  rollbackOf        ProvisioningLog?      @relation("RollbackRelation", fields: [rollbackLogId], references: [id], onDelete: SetNull)
  rollbackBy        ProvisioningLog[]     @relation("RollbackRelation")
  scheduledBy       ScheduledProvisioning?
  requestBy         ProvisioningRequest?

  executedAt DateTime @default(now())
  executedBy String?

  @@index([deviceId, executedAt])
  @@index([ontSerial])
  @@index([executionMode])
  @@index([rollbackLogId])
}

model Anomaly {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  metricType   String
  timestamp    DateTime        @default(now())
  anomalyScore Float
  severity     AnomalySeverity

  // Enhanced Anomaly fields for Phase 1 & Phase 2
  explanation          Json?   // { summary, topContributors, recommendation }
  contributingFeatures Json?   // [{ featureName, value, normalValue, deviation, contribution }]
  confidence           Float?  // Ensemble confidence (0-1)
  algorithmVotes       Json?   // { isolationForest: { score, isAnomaly }, lof: { ... } }

  autoResolved Boolean   @default(false)
  resolvedAt   DateTime?

  feedback   AnomalyFeedback?

  @@index([deviceId, timestamp])
  @@index([severity])
}

model AnomalyModel {
  id            String   @id @default(cuid())
  deviceId      String?
  deviceType    String?  // ROUTER, SWITCH, OLT, ALL

  modelData     Json     // Serialized forest structure & state
  algorithm     String   @default("ISOLATION_FOREST")

  version       Int      @default(1)
  trainedAt     DateTime @default(now())
  trainingSize  Int      // Number of samples used

  featureNames  Json     // Array of feature names used
  stats         Json     // Normalization stats { mean, std }
  scoreStats    Json     // Calibration stats { mean, std, p90, p95, p99 }

  performance   Json?    // Performance metrics
  hyperParams   Json?    // { nTrees, maxSamples, contamination }

  isActive      Boolean  @default(true)
  replacedBy    String?

  createdAt     DateTime @default(now())

  @@index([deviceId, isActive])
  @@index([deviceType, isActive])
  @@index([trainedAt])
}

enum FeedbackType {
  TRUE_POSITIVE
  FALSE_POSITIVE
  UNKNOWN
  EXPECTED_BEHAVIOR
}

model AnomalyFeedback {
  id        String      @id @default(cuid())
  anomalyId String      @unique
  anomaly   Anomaly     @relation(fields: [anomalyId], references: [id], onDelete: Cascade)

  feedback  FeedbackType
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  comment   String?
  tags      Json?       // ["maintenance", "expected"]

  createdAt DateTime    @default(now())

  @@index([feedback])
  @@index([createdAt])
}

model CorrelationPattern {
  id            String   @id @default(cuid())
  pattern       String   @unique
  devices       Json     // Array of device IDs
  support       Float
  confidence    Float
  timeWindow    Int      // seconds
  occurrences   Int      @default(1)
  lastSeen      DateTime
  patternType   String   // cascade, cooccurrence, periodic, dependency
  metadata      Json     // { avgTimeDiff, stdTimeDiff, directionality }

  @@index([confidence])
  @@index([support])
  @@index([lastSeen])
}

model AnomalyRiskPrediction {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  riskScore   Float    // 0-1
  riskLevel   String   // LOW, MEDIUM, HIGH, CRITICAL

  predictedAt DateTime
  horizon     Int      // Minutes ahead (default 60)

  // Outcome tracking (for model validation)
  actualAnomaly Boolean?
  validatedAt   DateTime?

  @@index([deviceId, predictedAt])
  @@index([riskScore])
}

model MaintenanceWindow {
  id       String  @id @default(cuid())
  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  name            String
  startAt         DateTime
  endAt           DateTime
  reason          String?
  suppressedTypes Json? // ["DEVICE_DOWN", "HIGH_UTILIZATION"]
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, startAt])
  @@index([isActive])
}

model Alert {
  id       String    @id @default(cuid())
  type     AlertType
  deviceId String?
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  message  String        @db.Text
  severity AlertSeverity
  status   AlertStatus   @default(ACTIVE)

  // Deduplikasi & korelasi alert
  dedupKey       String? // fingerprint: icmp:down:{deviceId}, snmp:cpu:{deviceId}, snmp:mem:{deviceId}
  correlationKey String? // grup korelasi: device:{deviceId}
  parentId       String?
  parentAlert    Alert?  @relation("AlertHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childAlerts    Alert[] @relation("AlertHierarchy")

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  // Perkuatan lifecycle/sumber (Tahap 1)
  firstTriggeredAt DateTime? // awal kemunculan (onset), untuk durasi/umur alert
  valueSnapshot    Json? // nilai metrik pemicu alert (mis. { cpu: 92.3 })
  assigneeId       String?
  assignee         User?     @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  note             String?   @db.Text

  // Tahap 2 — eskalasi
  escalationLevel Int @default(0) // 0 = normal; 1..N jejak tangga eskalasi

  activities  AlertActivity[]
  deliveries  AlertDelivery[]
  escalations AlertEscalation[]

  @@index([status, severity])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([dedupKey])
  @@index([correlationKey])
  @@index([parentId])
}

// ─── Timeline aktivitas per alert (siapa & kapan mengubah lifecycle) ───────────
model AlertActivity {
  id        String              @id @default(cuid())
  alertId   String
  alert     Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  action    AlertActivityAction
  actorId   String? // id user (redeem sekadar untuk audit)
  actorName String? // snapshot nama user saat aksi
  message   String?             @db.Text
  details   Json?
  createdAt DateTime            @default(now())

  @@index([alertId, createdAt])
}

// ─── Rekam jejak pengiriman notifikasi per channel ────────────────────────────
model AlertDelivery {
  id          String              @id @default(cuid())
  alertId     String
  alert       Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel     String // "telegram" | "email" | "webhook" | "sms" | "siem"
  status      AlertDeliveryStatus @default(PENDING)
  attempts    Int                 @default(0)
  error       String?             @db.Text
  sentAt      DateTime?
  nextRetryAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([alertId, status])
  @@index([createdAt])
}

// ─── Jejak langkah eskalasi per alert (Tahap 2) ───────────────────────────────
model AlertEscalation {
  id          String   @id @default(cuid())
  alertId     String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  level       Int // tangga eskalasi (1,2,3…)
  triggeredAt DateTime @default(now())
  details     Json?

  @@index([alertId, level])
  @@index([triggeredAt])
}

// ─── Rule threshold user-configurable (Tahap 3) ───────────────────────────────
model AlertRule {
  id                 String               @id @default(cuid())
  name               String
  // "cpu" | "mem" | "latency" | "packetLoss" | "jitter" | "customOid"
  metric             String
  operator           AlertRuleOperator    @default(GTE)
  threshold          Float
  severity           AlertSeverity        @default(HIGH)
  // anti-flapping: berapa sampel berturut-turut sebelum alert diangkat
  consecutiveSamples Int                  @default(2)
  deviceScope        AlertRuleDeviceScope @default(ALL)
  deviceType         DeviceType?
  deviceIds          Json? // array deviceId saat scope = DEVICES
  customOidId        String?
  customOid          CustomOid?           @relation(fields: [customOidId], references: [id], onDelete: SetNull)
  enabled            Boolean              @default(true)
  cooldownMs         Int                  @default(300000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([metric])
}

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?  @unique
  fullName     String?
  role         UserRole @default(OPERATOR)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  assignedAlerts Alert[]         @relation("AlertAssignee")
  backupRestores BackupRestore[]
  anomalyFeedbacks AnomalyFeedback[]
}

// ─── Custom SNMP OID per device / vendor ─────────────────────────────────────
model CustomOid {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  name        String // label tampilan, mis. "CPU Huawei" / "Fan Speed"
  oid         String // dotted-decimal OID, mis. "1.3.6.1.4.1.2011.5.2.1.0"
  unit        String? // satuan tampilan, mis. "°C", "%", "rpm"
  description String? @db.Text
  // Threshold alert untuk OID ini (null = tidak ada alert)
  alertHigh   Float?
  alertLow    Float?
  enabled     Boolean @default(true)

  alertRules AlertRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([enabled])
}

// ─── Dynamic / auto threshold per device per metric ──────────────────────────
model DeviceThreshold {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  metric         String // "latency" | "packetLoss" | "jitter" | "cpu" | "mem"
  // Nilai threshold hasil komputasi otomatis (mean + N*stddev)
  dynamicHigh    Float? // nilai alert upper-bound dinamis
  dynamicLow     Float? // nilai alert lower-bound (opsional)
  baselineMean   Float? // mean historis saat komputasi
  baselineStddev Float? // stddev historis
  sampleCount    Int      @default(0)
  // Override manual (null = gunakan dynamic)
  manualHigh     Float?
  manualLow      Float?
  // Kapan threshold terakhir di-compute
  computedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([deviceId, metric])
  @@index([deviceId])
  @@index([computedAt])
}
