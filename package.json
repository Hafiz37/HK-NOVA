{
  "name": "hk-nova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:workers": "concurrently -n \"ICMP,DEMO\" -c \"blue,magenta\" \"pnpm worker:icmp\" \"pnpm demo:generator\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "generate": "prisma generate",
    "worker:icmp": "tsx watch src/workers/icmp-poller.ts",
    "worker:snmp": "tsx watch src/workers/snmp-poller.ts",
    "worker:retention": "tsx watch src/workers/retention-worker.ts",
    "worker:backup": "tsx watch src/workers/backup-worker.ts",
    "worker:backup-retention": "tsx watch src/workers/backup-retention-worker.ts",
    "worker:backup-archive": "tsx watch src/workers/backup-archive-worker.ts",
    "worker:backup-notifications": "tsx watch src/workers/backup-notification-worker.ts",
    "worker:anomaly": "tsx watch src/workers/anomaly-detector.ts",
    "worker:escalator": "tsx watch src/workers/alert-escalator.ts",
    "worker:digest": "tsx watch src/workers/digest-worker.ts",
    "worker:retry": "tsx watch src/workers/delivery-retry.ts",
    "worker:scheduled-provisioning": "tsx watch src/workers/scheduled-provisioning-worker.ts",
    "demo:generator": "tsx watch src/workers/demo-generator.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:agents": "bash scripts/demo/snmp-agents.sh",
    "demo:setup": "pnpm demo:seed && echo '\n💡 Demo devices seeded. Optionally run: pnpm demo:agents'",
    "demo:reset": "prisma migrate reset --force && pnpm db:seed && pnpm demo:seed",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "test:phase1": "tsx scripts/test-phase1.ts",
    "test:phase2": "tsx scripts/test-phase2-snmp.ts",
    "test:anomaly": "tsx scripts/test-anomaly.ts",
    "test:provisioning": "vitest run tests/integration/provisioning",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "isolation-forest": "^0.0.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "net-ping": "^1.2.4",
    "net-snmp": "^3.26.3",
    "next": "16.3.0",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^1.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5",
  "optionalDependencies": {
    "aws-sdk": "^2.1693.0",
    "mock-aws-s3": "^4.0.2",
    "nock": "^14.0.17"
  }
}
