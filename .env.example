# Copy this file to .env and update the values

DATABASE_URL="mysql://root:password@localhost:3306/hk_nova_dev"

ENCRYPTION_KEY="generate-random-32-bytes-hex-string"
AUDIT_HMAC_KEY="generate-random-32-chars-string"

JWT_SECRET="your-jwt-secret-change-in-production"
OPERATOR_USERNAME="admin"
OPERATOR_PASSWORD="admin123"

TELEGRAM_BOT_TOKEN=""
# Multiple chat IDs untuk multi-recipient, dipisahkan koma:
TELEGRAM_CHAT_ID=""

# Email / SMTP (kanal notifikasi Email)
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noc@example.com"
SMTP_RECIPIENTS=""

# Webhook (Slack / Discord) — multiple URL dipisahkan koma
NOTIFY_WEBHOOK_URLS=""

# SIEM (Splunk HEC / Elasticsearch / collector HTTP generic)
# Format payload: "generic" (JSON langsung) atau "splunk" (bungkus protokol HEC)
SIEM_WEBHOOK_URLS=""
SIEM_WEBHOOK_TOKEN=""
SIEM_FORMAT="generic"

# SMS Gateway
# provider "generic": POST JSON { api_key, sender_id, to, message } ke SMS_API_URL
# provider "twilio":  menggunakan accountSid + apiKey (auth token)
SMS_API_URL=""
SMS_API_KEY=""
SMS_ACCOUNT_SID=""
SMS_SENDER_ID=""
SMS_TO_NUMBERS=""

# Rate limiting (opsional, default sudah aman)
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_TEST_LIMIT=10
RATE_LIMIT_MUTATION_LIMIT=30
RATE_LIMIT_USERS_LIMIT=15
RATE_LIMIT_SETTINGS_LIMIT=15
RATE_LIMIT_EXPORT_LIMIT=5
RATE_LIMIT_READ_LIMIT=60
RATE_LIMIT_READ_LOOPBACK_LIMIT=2000

ICMP_POLL_INTERVAL="*/1 * * * *"
ICMP_BATCH_SIZE=20
# Maks concurrent ICMP polls per batch (hindari overload NIC)
ICMP_CONCURRENCY_LIMIT=10
SNMP_POLL_INTERVAL="*/5 * * * *"
# Maks device per batch SNMP
SNMP_BATCH_SIZE=20
# Maks concurrent SNMP sessions per batch
SNMP_CONCURRENCY_LIMIT=10
BACKUP_DEFAULT_SCHEDULE="0 2 * * *"  # (deprecated) gunakan BACKUP_CRON_SCHEDULE
BACKUP_CRON_SCHEDULE="0 2 * * *"      # jadwal backup otomatis (cron)
BACKUP_RUN_ON_STARTUP="true"
BACKUP_CONCURRENCY=4

# Backup Encryption & Compression (Phase 1)
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS=365
BACKUP_SOFT_DELETE_GRACE_DAYS=30
BACKUP_CLEANUP_SCHEDULE="0 4 * * *"

# Backup Tiered Storage (Phase 2)
BACKUP_STORAGE_TIERED="false"
BACKUP_HOT_DAYS=30
BACKUP_FILESYSTEM_PATH="/var/backups/hk-nova"
BACKUP_ARCHIVE_SCHEDULE="0 3 * * *"
BACKUP_ARCHIVE_BATCH_SIZE=100

# Backup Phase 3: Smart Scheduling & Bandwidth Control
BACKUP_MAX_PER_SUBNET=2
BACKUP_SKIP_HIGH_LATENCY=true
BACKUP_LATENCY_THRESHOLD_MS=500
BACKUP_ALLOWED_HOURS="02:00-05:00"

# Backup Phase 4: Notifications & Compliance
BACKUP_NOTIFICATIONS_ENABLED="true"
BACKUP_DAILY_DIGEST_ENABLED="true"
BACKUP_DAILY_DIGEST_TIME="08:00"
BACKUP_CRITICAL_ALERTS_ENABLED="true"
BACKUP_STORAGE_ALERTS_ENABLED="true"
BACKUP_STORAGE_ALERT_THRESHOLD=80
BACKUP_FAILED_ALERTS_ENABLED="true"
BACKUP_FAILED_ALERT_THRESHOLD=3
BACKUP_WEBHOOK_URL=""
BACKUP_EMAIL_RECIPIENTS=""

RATE_LIMIT_PROVISION_LIMIT=10
RATE_LIMIT_PROVISION_LOOPBACK_LIMIT=2000
# Reserved untuk fitur ML Anomaly Detection (belum diimplementasikan):
ANOMALY_CHECK_INTERVAL="*/10 * * * *"

# Worker Schedules (cron format)
ESCALATOR_INTERVAL="* * * * *"
RETENTION_BATCH_SIZE=1000
RETENTION_CRON_SCHEDULE="0 3 * * *"
RETENTION_DRY_RUN="false"
RETRY_INTERVAL="*/2 * * * *"
SCHEDULED_PROVISIONING_CRON="* * * * *"
DIGEST_INTERVAL="* * * * *"
APP_MODE="development"

ENABLE_OLT_EXECUTION="false"
# Reserved untuk fitur ML Anomaly Detection (belum diimplementasikan):
ENABLE_ML_ANOMALY="true"

# Demo Mode (optional)
# Device demo akan tersedia di UI dengan toggle on/off
# Generator sintetis bisa diaktifkan via pnpm demo:generator
DEMO_MODE_ENABLED="true"

# Redis Queue untuk polling worker (opsional — fallback ke in-memory)
# Format: redis://[:password@]host[:port][/db]
REDIS_URL="redis://localhost:6379"
# TTL key antrian Redis dalam detik (default 600 = 10 menit)
REDIS_QUEUE_TTL_SECONDS=600

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
