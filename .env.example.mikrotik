# MikroTik API Configuration for Testing
# Copy these to your .env or .env.local file

# MikroTik Test Connection
MIKROTIK_TEST_HOST=192.168.88.1
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASS=your_mikrotik_password

# Contoh untuk multiple MikroTik routers (untuk production nanti)
# MIKROTIK_ROUTER_1_HOST=10.10.1.1
# MIKROTIK_ROUTER_1_USER=api_user
# MIKROTIK_ROUTER_1_PASS=secure_password
# 
# MIKROTIK_ROUTER_2_HOST=10.10.2.1
# MIKROTIK_ROUTER_2_USER=api_user
# MIKROTIK_ROUTER_2_PASS=secure_password
